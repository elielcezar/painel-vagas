# Copie este arquivo para ".env.local" e cole a sua connection string do MongoDB Atlas.
# Enquanto MONGODB_URI estiver vazio, o painel usa um arquivo local (data/vagas.json)
# para você testar sem banco. Ao preencher, ele passa a usar o Atlas automaticamente.
#
# NUNCA compartilhe a URI (ela contém usuário e senha). O arquivo .env.local fica fora do git.

MONGODB_URI=
MONGODB_DB=painel_vagas
